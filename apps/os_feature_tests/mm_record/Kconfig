config BL_OS_FEATURE_TESTS_MM_RECORD
	bool "Heap allocation record test"
	default n
	depends on BUILD_FLAT && BUILTIN && !DISABLE_PTHREAD
	depends on MM_RECORD_PID && MM_RECORD_SEQNO
	---help---
		Enable the deterministic heap allocation record test.

if BL_OS_FEATURE_TESTS_MM_RECORD

config BL_OS_FEATURE_TESTS_MM_RECORD_PROGNAME
	string "Program name"
	default "mm_record_test"

config BL_OS_FEATURE_TESTS_MM_RECORD_PRIORITY
	int "Task priority"
	default 100

config BL_OS_FEATURE_TESTS_MM_RECORD_STACKSIZE
	int "Stack size"
	default 4096 if BL_OS_FEATURE_TESTS_MM_RECORD_REALLOC_STACK
	default 2048

config BL_OS_FEATURE_TESTS_MM_RECORD_WORKER_STACKSIZE
	int "Worker thread stack size"
	default PTHREAD_STACK_DEFAULT

config BL_OS_FEATURE_TESTS_MM_RECORD_REALLOC_STACK
	bool "Default allocator realloc stack test"
	default n
	depends on MM_DEFAULT_MANAGER && MM_RECORD_STACK && FS_PROCFS
	depends on !FS_PROCFS_EXCLUDE_MEMINFO
	---help---
		Enable deterministic private-heap tests for realloc stack record
		ownership. This option uses NuttX default allocator internals only in
		the test application.

config BL_OS_FEATURE_TESTS_MM_RECORD_STACK
	bool "Heap backtrace contract test"
	default n
	depends on MM_DEFAULT_MANAGER && MM_RECORD_STACK
	depends on FS_PROCFS && !FS_PROCFS_EXCLUDE_MEMINFO
	depends on !FS_PROCFS_EXCLUDE_MEMDUMP
	depends on BL_OS_FEATURE_TESTS_MM_RECORD
	depends on BL_OS_FEATURE_TESTS_MM_RECORD_REALLOC_STACK
	---help---
		Enable the M02 heap backtrace gate, filter, pool and KASAN tests.
		The test uses one application main and a test-only private heap.

endif

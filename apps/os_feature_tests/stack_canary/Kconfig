	string "Program name"
	default "stack_canary_test"

config BL_OS_FEATURE_TESTS_STACK_CANARY_PRIORITY
	int "Task priority"
	default 100

config BL_OS_FEATURE_TESTS_STACK_CANARY_STACKSIZE
	int "Stack size"
	default 2048


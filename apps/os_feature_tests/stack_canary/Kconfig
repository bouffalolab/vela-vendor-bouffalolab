config BL_OS_FEATURE_TESTS_STACK_CANARY
	bool "Compiler stack canary test"
	default n
	depends on BUILD_FLAT && BUILTIN && STACK_CANARIES
	---help---
		Enable the deterministic compiler stack canary test.

if BL_OS_FEATURE_TESTS_STACK_CANARY


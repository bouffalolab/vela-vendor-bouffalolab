menuconfig BL_MCU_PERIPHERAL_TESTS_PWM
	tristate "MCU peripheral PWM tests"
	default n
	depends on AI_M64P_KIT_PWM && BL616CL_PWM
	depends on !PWM_PULSECOUNT
	depends on !PWM_FREQUENCY_FIXED && !PWM_DEADTIME
	---help---
		Enable the BL616CL PWM test runner. It drives /dev/pwm0 through
		the standard PWM ioctls and checks their results. With a GPIO
		input wired to the primary channel output (-g) it also checks the
		idle level after STOP. Waveform frequency and duty are measured
		with a logic analyzer.

if BL_MCU_PERIPHERAL_TESTS_PWM

config BL_MCU_PERIPHERAL_TESTS_PWM_PROGNAME
	string "Program name"
	default "mcu_pwm_test"

config BL_MCU_PERIPHERAL_TESTS_PWM_PRIORITY
	int "Task priority"
	default 100

config BL_MCU_PERIPHERAL_TESTS_PWM_STACKSIZE
	int "Stack size"
	default 6144

endif

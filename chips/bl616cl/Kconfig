#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_CHIP_CUSTOM

comment "BouffaloLab BL616CL Configuration Options"

choice
	prompt "BouffaloLab Chip Selection"
	default ARCH_CHIP_BL616CL

config ARCH_CHIP_BL616CL
	bool "BL616CL"
	select ARCH_RV32
	select ARCH_HAVE_FPU
	select ARCH_HAVE_MISALIGN_EXCEPTION
	select ARCH_HAVE_RESET
	select ARCH_RV_ISA_M
	select ARCH_RV_ISA_A
	select ARCH_RV_ISA_C
	select ARCH_RV_ISA_ZICSR_ZIFENCEI
	select ONESHOT
	select ONESHOT_COUNT
	select ONESHOT_FAST_DIVISION
	select ALARM_ARCH
	---help---
		BouffaloLab BL616CL E907 platform.

endchoice

menu "BL616CL Peripheral Support"

menuconfig BL616CL_UART
	bool "UART"
	default y
	select ARCH_HAVE_SERIAL_TERMIOS

if BL616CL_UART

config BL616CL_UART0
	bool "UART0"
	default y
	select UART0_SERIALDRIVER

if BL616CL_UART0

config BL616CL_UART0_RXPIN
	int "UART0 RX pin"
	range 0 36
	default 35

config BL616CL_UART0_TXPIN
	int "UART0 TX pin"
	range 0 36
	default 34

endif # BL616CL_UART0

config BL616CL_UART1
	bool "UART1"
	default n
	depends on BL616CL_UART0
	select UART1_SERIALDRIVER
	---help---
		Build the UART1 standard serial lower-half. Board code owns pin
		selection and /dev/ttyS1 registration. UART1 console, flow control,
		and RX/TX DMA are not supported by this lower-half. The BL616CL
		integration requires UART0 to remain the serial console.

if BL616CL_UART1

config UART1_BITS
	range 5 8

config UART1_2STOP
	range 0 1

endif # BL616CL_UART1

endif # BL616CL_UART

config BL616CL_WDT
	bool "Watchdog Timer (WDT)"
	default n
	select WATCHDOG
	select BL616CL_WDT_CAPTURE if WATCHDOG_AUTOMONITOR_BY_CAPTURE
	---help---
		Enable the BL616CL watchdog timer lower half driver.
		The timeout unit is milliseconds and the maximum value
		is 63999 ms with the default 32 kHz clock. Capture support
		is selected automatically when automonitor uses capture.

config BL616CL_WDT_CAPTURE
	bool "Watchdog interrupt capture"
	default n
	depends on BL616CL_WDT
	---help---
		Enable watchdog interrupt capture mode and the WDT IRQ handler.

config BL616CL_TRNG
	bool "True random number generator (TRNG)"
	default n
	select ARCH_HAVE_RNG
	---help---
		Enable the BL616CL security engine TRNG. DEV_RANDOM controls the
		standard /dev/random device. DEV_URANDOM remains independent and
		uses the same hardware when DEV_URANDOM_ARCH is selected.

menuconfig BL616CL_I2C
	bool "I2C master"
	default n
	select I2C
	select I2C_DRIVER
	select I2C_POLLED
	---help---
		Enable the BL616CL polling I2C master lower-half. Board code owns
		the pin selection and /dev/i2cN registration.

if BL616CL_I2C

config BL616CL_I2C0
	bool "I2C0 controller"
	default n

config BL616CL_I2C1
	bool "I2C1 controller"
	default n

config BL616CL_I2C_TEST
	bool
	default n
	---help---
		Enable the test-only transport hook used by the vendor I2C contract
		tests. Product configurations must leave this option disabled.

endif # BL616CL_I2C

menuconfig BL616CL_SPI
	bool "SPI master"
	default n
	select SPI
	select SPI_EXCHANGE
	select ARCH_HAVE_SPI_BITORDER
	---help---
		Enable the BL616CL polling SPI master lower-half. Board code owns
		pin selection, chip-select mapping, and /dev/spiN registration.

if BL616CL_SPI

config BL616CL_SPI0
	bool "SPI0 controller"
	default n

config BL616CL_SPI1
	bool "SPI1 controller"
	default n
	---help---
		Build the independent SPI1 lower-half. The Ai-M64L-32S-Kit SPI1
		four-wire pin mapping is not yet verified, so board registration is
		intentionally unavailable.

config BL616CL_SPI_TEST
	bool
	default n
	---help---
		Enable test-only transport and diagnostic hooks. Product
		configurations must leave this option disabled.

endif # BL616CL_SPI

config BL616CL_PWM
	bool "Pulse-width modulation (PWM)"
	default n
	depends on PWM
	depends on !PWM_PULSECOUNT
	depends on !PWM_MULTICHAN
	depends on !PWM_FREQUENCY_FIXED
	depends on !PWM_DEADTIME
	---help---
		Enable the BL616CL PWM lower-half for one continuous-output channel.
		The initial board integration uses PWM0 channel 3 positive output.
		Pulse count, multichannel, fixed-point frequency, and dead-time ABIs
		are intentionally excluded until their hardware paths are adapted.

if BL616CL_PWM

config BL616CL_PWM_TEST
	bool
	default n
	---help---
		Enable test-only timeout injection and diagnostic hooks. Product
		configurations must leave this option disabled.

endif # BL616CL_PWM

menuconfig BL616CL_RTC
	bool "Real-time clock (RTC)"
	default n
	select RTC
	select RTC_DATETIME
	select RTC_DRIVER
	select RTC_ARCH
	select ARCH_HAVE_RTC_SUBSECONDS
	---help---
		Enable the BL616CL HBN 48-bit counter as the OpenVela wall-clock
		RTC and register the standard /dev/rtc0 device. The system timer
		continues to provide elapsed time.

if BL616CL_RTC

choice
	prompt "RTC F32K clock source"
	default BL616CL_RTC_CLOCK_DIG32K

config BL616CL_RTC_CLOCK_RC32K
	bool "Internal RC32K"
	---help---
		Use the always-on internal RC32K oscillator. This source has no
		external dependency but has lower frequency accuracy. RTC conversion
		uses the SDK nominal F32K frequency of 32768 Hz; actual drift must be
		measured on the target board.

config BL616CL_RTC_CLOCK_DIG32K
	bool "40 MHz crystal divided clock"
	---help---
		Derive the RTC clock from the 40 MHz crystal through the fixed
		1221 divider. RTC conversion uses the resulting rational frequency,
		40000000 / 1221 Hz, instead of assuming exactly 32768 Hz.

endchoice

config BL616CL_RTC_ALARM
	bool "RTC alarm"
	default n
	select RTC_ALARM
	---help---
		Enable one standard absolute or relative RTC alarm using the full
		48-bit HBN compare and the HBN_OUT0 interrupt. This option owns the
		shared HBN_OUT0 IRQ until a common HBN dispatcher is introduced.
		Changing RTC time reprograms an active absolute alarm. If the new time
		passes the alarm, the alarm expires immediately.

endif # BL616CL_RTC

config BL616CL_ONESHOT
	bool "One-shot timer"
	default n
	select ONESHOT
	---help---
		Enable the BL616CL TIMER1 one-shot lower-half driver.

config BL616CL_TIMER
	bool "Timer"
	default n
	select TIMER
	---help---
		Enable the BL616CL timer lower-half driver.

if BL616CL_TIMER

config BL616CL_TIMER0
	bool "Timer 0"
	default y

config BL616CL_TIMER1
	bool "Timer 1"
	default n
	depends on !BL616CL_ONESHOT
	---help---
		Enable the BL616CL TIMER1 ordinary timer lower-half. TIMER1 is
		shared with the one-shot driver and is therefore mutually exclusive.

config BL616CL_TIMER_TEST
	bool
	default n
	depends on BL616CL_TIMER
	---help---
		Enable the test-only lower-half callback contract hook. This is
		selected by the vendor timer test and must remain disabled in
		product configurations.

endif # BL616CL_TIMER

config BL616CL_GPIO
	bool "GPIO Controller (ioexpander)"
	default n
	select IOEXPANDER
	select DEV_GPIO
	select GPIO_LOWER_HALF
	select IOEXPANDER_INT_ENABLE
	---help---
		Enable the BL616CL GPIO controller driver based on the
		ioexpander framework. Board code registers individual
		pins as /dev/gpioN devices via gpio_lower_half().

if BL616CL_GPIO

if IOEXPANDER_INT_ENABLE

config BL616CL_GPIO_INT_NCALLBACKS
	int "Number of GPIO interrupt callbacks"
	default 4
	range 1 255

endif # IOEXPANDER_INT_ENABLE
endif # BL616CL_GPIO

endmenu

endif

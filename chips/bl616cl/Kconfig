config BL616CL_PWM
	bool "Pulse-width modulation (PWM)"
	default n
	depends on PWM
	depends on !PWM_PULSECOUNT
	depends on !PWM_FREQUENCY_FIXED
	depends on !PWM_DEADTIME
	---help---
		Enable the BL616CL PWM0 lower-half for continuous output. The four
		channels share one counter and always run at the same frequency.
		Each channel drives a positive output, a negative output that is its
		complement, or both. If no channel has a negative output, the
		single-ended pin layout is used, which offers twice as many pins
		for positive outputs. With PWM_MULTICHAN, channel numbers 1 to 4
		select channels 0 to 3; without it the board configures exactly one
		channel. Pulse count, fixed-point frequency and dead-time ABIs are
		not supported.

menuconfig BL616CL_ADC
	bool "General-purpose ADC (GPADC)"
	default n
	select ANALOG
	select ADC
	---help---
		Enable the BL616CL GPADC lower-half for the ADC upper-half driver.
		Board code selects the external channels, which are scanned in a
		fixed order as single-ended 16-bit conversions against the
		internal reference. read() returns the channel number and the
		calibrated input in millivolts (0 to 3200). ANIOC_TRIGGER starts
		the conversions as set by the transfer mode below.

if BL616CL_ADC

choice
	prompt "Transfer mode"
	default BL616CL_ADC_POLL

config BL616CL_ADC_POLL
	bool "Polled single scan"
	---help---
		Each ANIOC_TRIGGER converts every channel once, waits for the
		results in the calling task and queues them before it returns.
		Takes no interrupt or worker.

config BL616CL_ADC_IRQ
	bool "Interrupt-driven continuous scan"
	select SCHED_HPWORK
	---help---
		ANIOC_TRIGGER starts a continuous scan that runs until the last
		close. The FIFO interrupt hands the samples to the high priority
		work queue, which queues them for read(). If samples are lost,
		because the work queue or the reader falls behind, the scan
		stops: read() returns the samples taken before the loss, then
		fails once with EIO, and ANIOC_TRIGGER starts a new scan.

endchoice # Transfer mode

config BL616CL_ADC_CLK_DIV
	int "ADC clock divider"
	default 20 if BL616CL_ADC_POLL
	default 64
	range 20 64
	---help---
		The ADC clock is the 40 MHz XCLK divided by this value. One
		16-bit sample takes about 129 us at 20 (2 MHz, the native SDK
		setting; faster clocks are not validated) and about 376 us at
		64. The slower clock gives the work queue more time to drain the
		16-sample FIFO in the interrupt-driven mode.

endif # BL616CL_ADC

menuconfig BL616CL_RTC
	bool "Real-time clock (RTC)"
	default n
	select RTC
	select RTC_DATETIME
	select RTC_DRIVER
	select RTC_ARCH
	select ARCH_HAVE_RTC_SUBSECONDS
	---help---
		Enable the BL616CL HBN 48-bit counter as the OpenVela wall-clock
		RTC and register the standard /dev/rtc0 device. The system timer
		continues to provide elapsed time.

if BL616CL_RTC

choice
	prompt "RTC F32K clock source"
	default BL616CL_RTC_CLOCK_DIG32K

config BL616CL_RTC_CLOCK_RC32K
	bool "Internal RC32K"
	---help---
		Use the always-on internal RC32K oscillator. This source has no
		external dependency but has lower frequency accuracy. RTC conversion
		uses the SDK nominal F32K frequency of 32768 Hz; actual drift must be
		measured on the target board.

config BL616CL_RTC_CLOCK_DIG32K
	bool "40 MHz crystal divided clock"
	---help---
		Derive the RTC clock from the 40 MHz crystal through the fixed
		1221 divider. RTC conversion uses the resulting rational frequency,
		40000000 / 1221 Hz, instead of assuming exactly 32768 Hz.

endchoice

config BL616CL_RTC_ALARM
	bool "RTC alarm"
	default n
	select RTC_ALARM
	---help---
		Enable one standard absolute or relative RTC alarm using the full
		48-bit HBN compare and the HBN_OUT0 interrupt. This option owns the
		shared HBN_OUT0 IRQ until a common HBN dispatcher is introduced.
		Changing RTC time reprograms an active absolute alarm. If the new time
		passes the alarm, the alarm expires immediately.

endif # BL616CL_RTC


menuconfig BL616CL_WDT
	bool "Watchdog Timer (WDT)"
	default n
	select WATCHDOG
	select BL616CL_WDT_CAPTURE if WATCHDOG_AUTOMONITOR_BY_CAPTURE
	---help---
		Enable the BL616CL watchdog timer lower half driver.
		The timeout unit is milliseconds and the maximum value
		is 63999 ms with the default 32 kHz clock. Capture support
		is selected automatically when automonitor uses capture.

if BL616CL_WDT

config BL616CL_WDT_CAPTURE
	bool "Watchdog interrupt capture"
	default n
	---help---
		Enable watchdog interrupt capture mode and the WDT IRQ handler.

endif # BL616CL_WDT

config BL616CL_SEC_ENG
	bool
	default n
	---help---
		Shared SEC_ENG support: the SEC peripheral clock and the engine
		locks. Selected by the drivers that use the security engine.

menuconfig BL616CL_CRYPTO
	bool "SEC_ENG hardware crypto driver"
	default y
	depends on CRYPTO_CRYPTODEV_HARDWARE
	select BL616CL_SEC_ENG
	---help---
		Register the SEC_ENG engines as the hardware driver of the crypto
		framework (hwcr_init()), used through /dev/crypto and the mbedTLS
		ALT layer. Requests complete synchronously; the driver polls the
		engine with a 100 ms limit per chunk.

if BL616CL_CRYPTO

config BL616CL_CRYPTO_AES
	bool "AES"
	default y
	---help---
		Register AES-CBC (CRYPTO_AES_CBC, CRYPTO_AES_192_CBC and
		CRYPTO_AES_256_CBC, each with 128, 192 or 256-bit keys), AES-CTR
		with a 128-bit counter, and AES-XTS with 128 or 256-bit keys.

config BL616CL_CRYPTO_SHA
	bool "SHA"
	default y
	---help---
		Register SHA-1 and SHA-2 (CRYPTO_SHA1, CRYPTO_SHA2_224,
		CRYPTO_SHA2_256, CRYPTO_SHA2_384 and CRYPTO_SHA2_512). HMAC is not
		registered; mbedTLS builds it from the hash.

config BL616CL_SEC_ENG_BOUNCE_SIZE
	int "Bounce buffer size per engine"
	default 1024
	range 128 65536
	---help---
		Size in bytes of the non-cacheable buffer through which each engine
		reads and writes data, and the largest chunk the engine processes
		at a time. Must be a multiple of 128. The engine does not snoop the
		CPU data cache, so data is copied through this buffer.

menuconfig BL616CL_SEC_ENG_DIRECT
	bool "Run large requests on the caller's buffers"
	default y
	---help---
		Let the engine read and write the caller's buffers directly, with
		the data cache cleaned and invalidated around the run, instead of
		copying through the bounce buffer. Used when the request is at
		least BL616CL_SEC_ENG_DIRECT_MIN bytes, both buffers are in internal
		RAM, the input is word aligned and the output covers whole 32-byte
		cache lines. Other requests, flash and PSRAM buffers, and AES-XTS
		use the bounce buffer.

if BL616CL_SEC_ENG_DIRECT

config BL616CL_SEC_ENG_DIRECT_MIN
	int "Smallest request run on the caller's buffers"
	default 256
	---help---
		Below this size the cache maintenance costs more than the copy
		through the bounce buffer saves.

endif # BL616CL_SEC_ENG_DIRECT

endif # BL616CL_CRYPTO

config BL616CL_TRNG
	bool "True random number generator (TRNG)"
	default CRYPTO_MBEDTLS
	select ARCH_HAVE_RNG
	select BL616CL_SEC_ENG
	imply MBEDTLS_ENTROPY_HARDWARE_ALT
	---help---
		Enable the BL616CL security engine TRNG. DEV_RANDOM controls the
		standard /dev/random device. DEV_URANDOM remains independent and
		uses the same hardware when DEV_URANDOM_ARCH is selected.

		Enabled by default with mbedTLS, which then takes its entropy
		from /dev/random (MBEDTLS_ENTROPY_HARDWARE_ALT) instead of
		getrandom(), whatever DEV_URANDOM implementation is selected.

menuconfig BL616CL_PERFMON
	bool "Performance monitor"
	default n
	---help---
		Count E907 events (I-cache and D-cache accesses and misses,
		conditional branches and mispredicts) with the hardware
		performance counters, and the calls and mcycle of every interrupt
		and exception in riscv_dispatch_irq().  Applications read them
		through arch/chip/bl616cl_perfmon.h; see the perfmon app.  It costs
		about 1.2 KiB of RAM and two CSR reads per interrupt.

if BL616CL_PERFMON

config BL616CL_PERFMON_PCSAMPLE
	bool "Tick PC sampling"
	default y
	---help---
		On every machine timer interrupt, count the interrupted PC in a
		histogram that the caller provides, or count an idle tick when
		the idle task was interrupted.  Code that runs with interrupts
		disabled, other interrupt handlers included, is never sampled;
		its time lands on the code that runs next.

endif # BL616CL_PERFMON

menuconfig BL616CL_DMA0
	bool "DMA0 generic DMA adapter"
	default n
	depends on DMA
	depends on !DMA_LINK
	---help---
		Enable the BL616CL DMA0 adapter for the OpenVela generic DMA API.
		It supports fixed-channel one-shot memory-to-memory and peripheral
		request transfers; with LLI nodes also longer one-shot transfers,
		cyclic transfers and pause/resume of cyclic transfers. The generic
		DMA_LINK interface is not supported.

		Each channel belongs to one user for good. All channels, of SDK
		drivers and of application code, are assigned in "DMA0 channel
		assignment"; the build fails if two users share one.

if BL616CL_DMA0

menu "DMA0 channel assignment"

comment "A driver keeps its channel; channels are never shared"

config BL616CL_I2S_TX_DMA_CHANNEL
	int "I2S0 TX"
	default 0
	range 0 7
	depends on BL616CL_I2S
	---help---
		DMA0 channel for I2S transmit. The I2S driver takes it at
		initialization and keeps it.

config BL616CL_I2S_RX_DMA_CHANNEL
	int "I2S0 RX"
	default 1
	range 0 7
	depends on BL616CL_I2S
	---help---
		DMA0 channel for I2S receive, kept like the TX channel.

config BL616CL_DBI_TX_DMA_CHANNEL
	int "DBI TX"
	default 2
	range 0 7
	depends on BL616CL_DBI_DMA
	---help---
		DMA0 channel that feeds the pixels to the DBI FIFO. The DBI
		display bus takes it when it starts and keeps it. The channel
		FIFO is 64 bytes on CH0 and CH1 and 32 bytes on CH2 and CH3,
		which run INCR8 bursts, and 16 bytes on CH4..CH7, which run INCR4.

config BL616CL_DISPLAY_SPI_TX_DMA_CHANNEL
	int "Display SPI TX"
	default 3
	range 0 7
	depends on BL616CL_DISPLAY_SPI_DMA
	---help---
		DMA0 channel that feeds the pixels to the FIFO of the display SPI
		controller. The display SPI bus takes it when it starts and keeps
		it.

config BL616CL_DMA0_APP_CHANNELS
	hex "Application code"
	default 0x0
	---help---
		Channels that code outside the SDK drivers takes with
		DMA_GET_CHAN, one bit per channel (bit n is CHn, up to 0xff).
		They count as assigned like the SDK driver channels: sharing one
		with an SDK driver fails the build, and tests leave them alone.

endmenu # DMA0 channel assignment

config BL616CL_DMA0_LLI_NODES
	int "DMA0 LLI nodes"
	default 96 if BL616CL_DBI_DMA && BL616CL_DISPLAY_SPI_DMA
	default 56 if BL616CL_DBI_DMA || BL616CL_DISPLAY_SPI_DMA
	default 16
	range 0 255
	---help---
		Linked-list nodes shared by all DMA0 channels, 16 bytes each. A
		one-shot transfer longer than 4095 units takes one node per 4064
		units after the first; a cyclic transfer takes one node per period,
		or more for periods longer than 4095 units. A transfer gets its
		nodes when it starts and returns them when it ends. 0 limits
		one-shot transfers to 4095 units and disables cyclic transfers.
		The default adds 40 nodes for each of the DBI and display SPI
		buses (BL616CL_DBI_DMA_LLI_COUNT, BL616CL_DISPLAY_SPI_DMA_LLI_COUNT),
		so that both can run their largest draw at once, to 16 for the
		other users.

endif # BL616CL_DMA0

menuconfig BL616CL_I2C
	bool "I2C master"
	default n
	select I2C
	select I2C_DRIVER
	---help---
		Enable the BL616CL I2C master lower-half. Transfers are interrupt
		driven by default; set I2C_POLLED (Device Drivers -> I2C Driver
		Support) to poll instead. Board code owns the pin selection and
		/dev/i2cN registration.

if BL616CL_I2C

config BL616CL_I2C0
	bool "I2C0 controller"
	default n
	---help---
		Build the I2C0 master lower-half; the board registers it as a
		NuttX I2C bus.

config BL616CL_I2C1
	bool "I2C1 controller"
	default n
	---help---
		Build the I2C1 master lower-half; the board registers it as a
		NuttX I2C bus.

endif # BL616CL_I2C

menuconfig BL616CL_I2S
	bool "I2S0 master"
	default n
	depends on AUDIO && BL616CL_DMA0
	select I2S
	select SCHED_HPWORK
	---help---
		Enable the BL616CL I2S0 lower-half (struct i2s_dev_s). The chip is
		the I2S master: it drives MCLK through CLKOUT, BCLK and FS, and
		moves samples with DMA0. Board code owns the pin selection and the
		codec registration. The DMA0 channels are set in "DMA0 channel
		assignment".

if BL616CL_I2S

config BL616CL_I2S_NBUFFERS
	int "Queued buffers"
	default 4
	range 2 16
	---help---
		Number of audio buffers the driver can hold at once, for both
		directions. send() and receive() wait for a free slot when all are
		in use.

menuconfig BL616CL_I2S_DMA_RING
	bool "Cyclic DMA ring"
	default y
	---help---
		Move the samples of each direction through a fixed ring with one
		cyclic DMA transfer. The period interrupt copies between the ring
		and the audio buffers, and may come up to the length of the other
		periods late (about 16 ms at 48 kHz with the defaults). TX sends
		silence while no data is queued. A TX buffer finishes when the
		next one goes into the ring, the last one when it has been
		played; buffers shorter than the ring leave silence at the start
		of a stream. Each direction keeps its ring in non-cacheable RAM
		and takes one DMA0 LLI node per period while it runs.

		Without it, each buffer goes out in one-shot DMA chunks of up to
		4095 words, and the DMA interrupt has to start the next chunk
		before the 16-word FIFO runs out, about 333 us at 48 kHz. That
		takes no extra RAM and copies nothing.

if BL616CL_I2S_DMA_RING

config BL616CL_I2S_RING_PERIODS
	int "Periods per ring"
	default 4
	range 2 16
	---help---
		Number of periods in each ring. TX and RX together take twice as
		many DMA0 LLI nodes while both run; the build fails if
		BL616CL_DMA0_LLI_NODES is smaller.

config BL616CL_I2S_RING_PERIOD_BYTES
	int "Period size in bytes"
	default 1024
	range 64 16380
	---help---
		Bytes per period, a multiple of 4 (one 16-bit stereo frame).
		1024 bytes is 256 frames, 5.33 ms at 48 kHz. Each direction has a
		static ring of this size times BL616CL_I2S_RING_PERIODS.

endif # BL616CL_I2S_DMA_RING

endif # BL616CL_I2S


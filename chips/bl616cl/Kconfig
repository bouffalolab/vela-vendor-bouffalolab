	bool "SPI1"
	depends on !BL616CL_SPI1

endchoice

config BL616CL_DISPLAY_SPI_MODE
	int "SPI mode"
	default 0
	range 0 3
	---help---
		Clock polarity and phase, common to all endpoints of the bus.

menuconfig BL616CL_DISPLAY_SPI_DMA
	bool "Send pixels with DMA0"
	default y
	depends on BL616CL_DMA0
	---help---
		DMA0 feeds the pixels to the SPI FIFO; the draw ends when the DMA
		has finished and the controller is idle. Without it the CPU sends
		the pixels by polling. The channel is set in "DMA0 channel
		assignment".

if BL616CL_DISPLAY_SPI_DMA

config BL616CL_DISPLAY_SPI_DMA_LLI_COUNT
	int "DMA0 LLI nodes per draw"
	default 40
	range 1 255
	---help---
		Largest draw, in DMA0 LLI nodes of 4064 16-bit units: 40 nodes
		carry 325120 bytes, two 240x320 RGB565 frames. A draw takes its
		nodes from BL616CL_DMA0_LLI_NODES while it runs; the build fails
		if that pool holds fewer than this count minus one.

endif # BL616CL_DISPLAY_SPI_DMA

endif # BL616CL_DISPLAY_SPI

config BL616CL_DISPLAY_SOFT_DBI_C
	bool "Software DBI type C bus"
	default n
	---help---
		Display bus bit-banged on GPIOs: MIPI DBI type C 3-wire, and
		4-wire with a DC pin. Synchronous and slow; used for the command
		port of RGB panels or small panels.

endif # BL616CL_DISPLAY

config BL616CL_TOUCH
	bool "Touch panel"
	default n
	select BL_COMPONENT_TOUCH
	select INPUT
	select INPUT_TOUCHSCREEN
	select SCHED_LPWORK
	---help---
		Enable the I2C touch controller drivers of the Bouffalo SDK
		(components/display/touch) as a NuttX touchscreen. The controller
		is read periodically from the low-priority work queue; board code
		picks the controller and registers /dev/inputN.

menuconfig BL616CL_WIRELESS
	bool "BL616CL wireless"
	default n
	select BL_COMPONENT_RFPARAM
	---help---
		Wi-Fi and BLE on the BL616CL radio. Both need the RF parameters
		(rfparam) that are loaded from flash before the radio starts.

if BL616CL_WIRELESS

menuconfig BL616CL_WIRELESS_WIFI
	bool "Wi-Fi station"
	default n
	select BL_COMPONENT_MACSW
	select BL_COMPONENT_WPA_SUPPLICANT
	select BL_COMPONENT_WL80211
	select BL616CL_TRNG
	---help---
		Wi-Fi station on the wl80211 stack with the macsw MAC firmware
		and the WPA supplicant, registered as the wlan0 network device.
		The supplicant and the mbedTLS entropy source read /dev/urandom,
		which BL616CL_TRNG makes default to the hardware TRNG.

if BL616CL_WIRELESS_WIFI

config BL616CL_WLAN_RX_ZEROCOPY
	bool "Wi-Fi RX zero-copy"
	default n
	select IOB_ALLOC
	---help---
		Hand received Wi-Fi frames of 500 bytes or more to the network
		stack in their wl80211 host RX slot, wrapped as an IOB that
		returns the slot when freed, instead of copying them into pool
		IOBs. Slots lent out are capped so that one BA session can still
		reorder; beyond the cap, and for short frames, frames are copied.
		A reply that the stack builds in a slot is copied into pool IOBs
		before it is sent. IOB_ALLOC adds 12 bytes to every pool IOB.

config BL616CL_FW_TASK_PRIORITY
	int "Wi-Fi firmware task priority"
	default 130
	---help---
		Priority of the "wifi_fw" task, which runs the MAC firmware and
		hands received frames to the driver.  Keep it below the work
		queue that runs the network stack (LPWORK, or HPWORK when
		SCHED_LPWORK is off) and above applications, so that it always
		preempts them.  With the network stack at 120, below this task,
		TCP TX dropped by about a quarter and UDP TX by about a third.
		At the priority of iperf (100) UDP RX overload got close to line
		rate and UDP TX lost 1-2 Mbit/s; below it (90) UDP TX lost 6-12
		Mbit/s.

menuconfig BL616CL_WIRELESS_WIFI_SOFTAP
	bool "Wi-Fi SoftAP"
	default n
	---help---
		SoftAP on the wl80211 AP interface, registered as a second
		network device, wlan1, next to the station wlan0.  It is driven
		with the standard wireless ioctls (wapi): SIOCSIWESSID with
		IW_ESSID_ON starts the AP, IW_ESSID_OFF or bringing wlan1 down
		stops it.  The AP is open, or WPA2-PSK (CCMP) once a passphrase
		is set, on 2.4 GHz with 20 MHz.  wlan1 gets no address from the
		driver; set one and run a DHCP server, e.g. dhcpd_start wlan1.

if BL616CL_WIRELESS_WIFI_SOFTAP

config BL616CL_WIRELESS_WIFI_SOFTAP_MAX_STA
	int "Maximum number of clients"
	range 1 4
	default 4
	---help---
		Clients the SoftAP accepts at a time; further association
		requests are refused.  wl80211 has room for four.

config BL616CL_WIRELESS_WIFI_SOFTAP_IDLE_TIMEOUT
	int "Idle client timeout (seconds)"
	range 0 2145
	default 300
	---help---
		A client the AP has received nothing from for this long is
		deauthenticated, so that clients which left without a deauth
		do not keep a place.  wl80211 checks every 5 seconds and the
		value is rounded up to a multiple of 5.  0 disables it.  The
		limit comes from the 32-bit microsecond timer wl80211 uses.

config BL616CL_WIRELESS_WIFI_SOFTAP_HIDDEN
	bool "Hide the SSID"
	default n
	---help---
		Beacons carry an empty SSID and wildcard probe requests are
		not answered, so clients have to be given the SSID.  WPS is not
		advertised, as WSC 2.0 requires for a hidden AP.  The SSID is
		still sent in probe responses and by the clients; this does not
		protect the network.

endif # BL616CL_WIRELESS_WIFI_SOFTAP

endif # BL616CL_WIRELESS_WIFI

menuconfig BL616CL_WIRELESS_BLE
	bool "BLE controller"
	default n
	depends on !BL616CL_EM_NONE
	depends on UART_BTH4
	select BL_COMPONENT_BLE
	---help---
		Link the prebuilt BL616CL BLE controller (m2s1: BLE only, two
		connections, all roles, 16 KiB EM) and register it as the H4
		pseudo device /dev/ttyHCI<BLUETOOTH_DEVICE_ID> for a host stack
		such as zblue.

if BL616CL_WIRELESS_BLE

config BL616CL_WIRELESS_BLE_PRIORITY
	int "Controller thread priority"
	default 200
	---help---
		The controller thread runs the link-layer scheduler after every
		BLE interrupt. Keep it above LPWORK (Wi-Fi) and the Wi-Fi firmware
		task, and below HPWORK.

config BL616CL_WIRELESS_BLE_STACKSIZE
	int "Controller thread stack size"
	default 3072

endif # BL616CL_WIRELESS_BLE

endif # BL616CL_WIRELESS

endif

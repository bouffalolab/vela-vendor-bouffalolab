if ARCH_CHIP_CUSTOM

comment "BOUFFALOLAB Configuration Options"

choice
    prompt "BOUFFALOLAB Chip Selection"
    default ARCH_CHIP_BL616CL

config ARCH_CHIP_BL616CL
	bool "bl616cl"
	select ARCH_CORTEXM4
	select ARCH_HAVE_MPU
	select ARM_HAVE_MPU_UNIFIED
	select ARCH_HAVE_FPU

endchoice


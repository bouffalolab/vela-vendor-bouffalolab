config BL_COMPONENT_WPA_SUPPLICANT
    bool "Bouffalo WPA supplicant"
    depends on ARCH_CHIP_BL616CL
    select CRYPTO_MBEDTLS
    select MBEDTLS_PKCS5_C
    select MBEDTLS_CIPHER_MODE_CTR
    select MBEDTLS_CIPHER_PADDING_PKCS7
    select MBEDTLS_ECP_DP_SECP256R1_ENABLED
    select MBEDTLS_ECP_C
    select MBEDTLS_ECDH_C
    select MBEDTLS_ECDSA_C
    select MBEDTLS_PK_WRITE_C
    select MBEDTLS_SHA512_C
    help
      Build the public Bouffalo supplicant sources with a NuttX OS port
      and the OpenVela mbedTLS library for wl80211. WPS and P2P are not
      enabled by this integration.

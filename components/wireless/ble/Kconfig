config BL_COMPONENT_BLE
	bool
	depends on ARCH_CHIP_BL616CL
	select BL_COMPONENT_RFPARAM
	help
	  Selected by BL616CL_WIRELESS_BLE. Links the prebuilt BL616CL BLE
	  controller library; the HCI transport and the NuttX port of the
	  library are built from chips/bl616cl.

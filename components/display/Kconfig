# No menu: component symbols have no prompt. BL_COMPONENT_DISPLAY is
# selected by BL616CL_DISPLAY, each panel description by the board option
# of the panel module that uses it.

config BL_COMPONENT_DISPLAY
	bool
	depends on ARCH_CHIP_BL616CL
	help
	  Selected by BL616CL_DISPLAY. Builds the display framework of the
	  Bouffalo SDK (display, bus and panel cores, the generic DCS panel
	  driver, the standard RGB panels, the scanout core and the simple
	  font) with its NuttX platform layer and, with LCD, the NuttX LCD
	  device glue.


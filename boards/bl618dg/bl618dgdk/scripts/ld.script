#include <nuttx/config.h>

OUTPUT_ARCH(riscv)
ENTRY(__start)

/* BL618DG AP RAM layout: 448 KiB starting at 0xa1000000.
 * The first 6 KiB is reserved for the entry point and header space.
 * Code, data, stacks and heap share the remaining RAM.
 * The AP must have exclusive use of this region. Load each ELF segment
 * at its linked address.
 */

MEMORY
{
  rom_header (rx) : ORIGIN = 0xa1000000, LENGTH = 6K
  ram (rwx)       : ORIGIN = CONFIG_RAM_START, LENGTH = CONFIG_RAM_SIZE
}

/* Keep load permissions separate within the shared OCRAM address range. */

PHDRS
{
  header PT_LOAD FLAGS(5);  /* Read + execute */
  text   PT_LOAD FLAGS(5);  /* Read + execute */
  data   PT_LOAD FLAGS(6);  /* Read + write */
}

SECTIONS
{
  ASSERT(ORIGIN(ram) == ORIGIN(rom_header) + LENGTH(rom_header),
         "BL618DG RAM must start after the 6 KiB header region")
  ASSERT(ORIGIN(ram) + LENGTH(ram) == 0xa1070000,
         "BL618DG AP RAM must end at 0xa1070000")

  .init :
  {
    _stext = ABSOLUTE(.);
    KEEP(*(.text.entry))
  } > rom_header :header

  .text :
  {
    *(.text .text.*)
    *(.gnu.linkonce.t.*)
    *(.rodata .rodata.* .srodata .srodata.*)
    . = ALIGN(8);
    _etext = ABSOLUTE(.);
  } > ram :text

  .init_array :
  {
    _sinit = ABSOLUTE(.);
    KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*)))
    KEEP(*(.init_array))
    _einit = ABSOLUTE(.);
  } > ram :text

  .zero.table (READONLY) :
  {
    __mem_setz_sections = ABSOLUTE(.);
    LONG(ADDR(.bss));
    LONG(ADDR(.bss) + SIZEOF(.bss));
    LONG(0xffffffff);
    LONG(0xffffffff);
  } > ram :text

  .data :
  {
    . = ALIGN(8);
    _sdata = ABSOLUTE(.);
    *(.data .data.* .sdata .sdata.*)
    *(.gnu.linkonce.d.*)
    . = ALIGN(8);
    _edata = ABSOLUTE(.);
  } > ram :data
  _eronly = LOADADDR(.data);
  __global_pointer$ = _sdata + 0x800;

  .bss (NOLOAD) :
  {
    . = ALIGN(8);
    _sbss = ABSOLUTE(.);
    *(.bss .bss.* .sbss .sbss.* COMMON)
    . = ALIGN(16);
    _ebss = ABSOLUTE(.);
  } > ram :data

  .noinit (NOLOAD) :
  {
    *(.noinit .noinit.*)
    . = ALIGN(16);
  } > ram :data

  /* The idle stack and heap follow _ebss. */

  ASSERT(SIZEOF(.noinit) == 0, "BL618DG requires an empty .noinit section")

  .idle_stack (NOLOAD) :
  {
    __StackBase = ABSOLUTE(.);
    . += CONFIG_IDLETHREAD_STACKSIZE;
    . = ALIGN(16);
    __StackTop = ABSOLUTE(.);
  } > ram :data

  ASSERT(__StackTop < ORIGIN(ram) + LENGTH(ram), "BL618DG RAM exhausted")

  /* Keep ELF metadata out of the loadable RAM segments. */

  .riscv.attributes 0 : { KEEP(*(.riscv.attributes)) } :NONE
  .rela.dyn 0 : { *(.rela.*) }
  ASSERT(SIZEOF(.rela.dyn) == 0, "BL618DG ELF needs runtime relocation")
  .debug_info 0 : { *(.debug_info .gnu.linkonce.wi.*) }
  .debug_abbrev 0 : { *(.debug_abbrev) }
  .debug_line 0 : { *(.debug_line .debug_line.*) }
  .debug_frame 0 : { *(.debug_frame) }
  .debug_str 0 : { *(.debug_str) }
  .debug_aranges 0 : { *(.debug_aranges) }
  .debug_ranges 0 : { *(.debug_ranges) }
  .debug_loc 0 : { *(.debug_loc) }
  .debug_macro 0 : { *(.debug_macro) }
  .debug_addr 0 : { *(.debug_addr) }
  .debug_line_str 0 : { *(.debug_line_str) }
  .debug_loclists 0 : { *(.debug_loclists) }
  .debug_rnglists 0 : { *(.debug_rnglists) }
  .debug_str_offsets 0 : { *(.debug_str_offsets) }
  .debug_pubnames 0 : { *(.debug_pubnames) }
  .debug_pubtypes 0 : { *(.debug_pubtypes) }
  /DISCARD/ : { *(.note.GNU-stack) *(.comment) }
}

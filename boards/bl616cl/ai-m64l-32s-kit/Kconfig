#

menuconfig AI_M64L_KIT_UART1
	bool "Ai-M64L-32S-Kit UART1"
	default n
	depends on BL616CL_UART0
	select BL616CL_UART1
	---help---
		Register UART1 as /dev/ttyS1 using the board-owned GPIO14 TX and
		GPIO15 RX test loopback pair. Runtime termios is independently
		controlled by SERIAL_TERMIOS.

menuconfig AI_M64L_KIT_I2C
	bool "Ai-M64L-32S-Kit I2C buses"
	default n
	select BL616CL_I2C
	---help---
		Register the selected board I2C buses. External 3.3 V targets and
		SCL/SDA pull-ups are required.

if AI_M64L_KIT_I2C

config AI_M64L_KIT_I2C0
	bool "Register I2C0"
	default y
	select BL616CL_I2C0

if AI_M64L_KIT_I2C0

config AI_M64L_KIT_I2C0_SCL_PIN
	int "I2C0 SCL pin"
	range 0 36
	default 4

config AI_M64L_KIT_I2C0_SDA_PIN
	int "I2C0 SDA pin"
	range 0 36
	default 5

endif # AI_M64L_KIT_I2C0

config AI_M64L_KIT_I2C1
	bool "Register I2C1"
	default n
	select BL616CL_I2C1

if AI_M64L_KIT_I2C1

config AI_M64L_KIT_I2C1_SCL_PIN
	int "I2C1 SCL pin"
	range 0 36
	default 12

config AI_M64L_KIT_I2C1_SDA_PIN
	int "I2C1 SDA pin"
	range 0 36
	default 13

endif # AI_M64L_KIT_I2C1
endif # AI_M64L_KIT_I2C

menuconfig AI_M64L_KIT_SPI
	bool "Ai-M64L-32S-Kit SPI buses"
	default n
	select BL616CL_SPI
	---help---
		Register board-selected SPI master buses. SPI0 uses GPIO chip select
		and exposes the OpenVela test device as /dev/spi0.

if AI_M64L_KIT_SPI

config AI_M64L_KIT_SPI0
	bool "Register SPI0"
	default y
	depends on !AI_M64L_KIT_I2C1
	select BL616CL_SPI0
	select SPI_DRIVER
	---help---
		Register SPI0 using the selected BL616CLDK-derived pin mapping.
		This setting owns the selected pins instead of the board GPIO tests.

if AI_M64L_KIT_SPI0

config AI_M64L_KIT_SPI0_CS_PIN
	int "SPI0 GPIO chip-select pin"
	range 0 36
	default 12

config AI_M64L_KIT_SPI0_CLK_PIN
	int "SPI0 clock pin"
	range 0 36
	default 13

config AI_M64L_KIT_SPI0_MISO_PIN
	int "SPI0 MISO pin"
	range 0 36
	default 18

config AI_M64L_KIT_SPI0_MOSI_PIN
	int "SPI0 MOSI pin"
	range 0 36
	default 19

config AI_M64L_KIT_SPI0_CS_ACTIVE_HIGH
	bool "SPI0 chip select is active high"
	default n

config AI_M64L_KIT_SPI0_TARGET_INDEX
	int "SPI0 target 0 SPIDEV_USER index"
	range 0 65535
	default 0

config AI_M64L_KIT_SPI0_TARGET1
	bool "SPI0 target 1"
	default n
	help
	  Enable a second GPIO chip select on SPI0. The target index and GPIO
	  must differ from target 0 and all SPI signal pins.

if AI_M64L_KIT_SPI0_TARGET1

config AI_M64L_KIT_SPI0_TARGET1_CS_PIN
	int "SPI0 target 1 GPIO chip-select pin"
	range 0 36
	default 20

config AI_M64L_KIT_SPI0_TARGET1_CS_ACTIVE_HIGH
	bool "SPI0 target 1 chip select is active high"
	default n

config AI_M64L_KIT_SPI0_TARGET1_INDEX
	int "SPI0 target 1 SPIDEV_USER index"
	range 0 65535
	default 1

endif # AI_M64L_KIT_SPI0_TARGET1

endif # AI_M64L_KIT_SPI0
endif # AI_M64L_KIT_SPI
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

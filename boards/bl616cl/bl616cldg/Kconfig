#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_CUSTOM

config BL616CLDG_BOARD_DIAGNOSTICS
	bool "Enable BL616CLDG board diagnostics"
	default n
	---help---
		Enable board diagnostics hooks for BL616CLDG.  Keep this disabled
		for baseline bring-up because SDK banner, version, flash-info and
		anti-rollback paths are not kernel start requirements.

config BL616CLDG_PSRAM_HEAP
	bool "Enable BL616CLDG PSRAM heap"
	default n
	---help---
		Enable BL616CLDG PSRAM heap registration.  Keep this disabled for
		baseline bring-up because PSRAM must be initialized and owned
		explicitly before it can be exposed to the NuttX heap.

config BL616CLDG_PERIPHERAL_CLOCKS
	bool "Enable BL616CLDG board peripheral clocks"
	default n
	---help---
		Enable board-managed peripheral clock setup.  Keep this disabled
		for baseline bring-up because each NuttX driver should own its
		clock source and gate when it is registered.

config BL616CLDG_PM_RECOVERY
	bool "Enable BL616CLDG PM recovery"
	default n
	---help---
		Enable BL616CLDG low-power recovery registration.  Keep this
		disabled for baseline bring-up because PSRAM, clock and UART
		restore ordering must be designed against the openvela PM model.

endif

#include <nuttx/config.h>

OUTPUT_ARCH(riscv)
ENTRY(__start)

/* One script for all BL616CL boards and configurations: it describes the
 * chip memory map and boot image. Differences come in as parameters, not
 * as edits: __bl616cl_app_size from the board partition table,
 * CONFIG_BL616CL_EM_SIZE and CONFIG_IDLETHREAD_STACKSIZE. Code and data
 * that need a special place use the section attributes collected below,
 * and the remaining RAM goes to the heap. A board with a different memory
 * layout points LD_SCRIPT at its own script.
 */

/* Layout
 *
 *   fw_header   0x7ffff000  boot header, 4 KiB before the XIP base
 *   rom_header  0x80000000  reset entry, multi-bin table, RF parameters,
 *                           version block, code run before the caches
 *   flash       0x80001800  load images of the RAM sections, then .text
 *                           from a 32 KiB boundary, .rodata, init array,
 *                           startup copy and zero tables
 *   ram_nocache 0x20fc0400  .nocache_data, .nocache_noinit
 *   ram         0x60fc0400  the same RAM, cacheable alias: a hole for the
 *                           nocache sections, .ram_code, .ram_rodata,
 *                           .data, .noinit, .bss, idle stack, then heap
 *   ram_wifi    0x20ff8000  WRAM below EM, .wifibss at its top
 *
 * bl616cl_section_load() copies the .copy.table entries and zeroes the
 * .zero.table entries at startup. NOLOAD sections get an explicit RAM
 * LMA so that they do not inherit the flash offset of the section before.
 */

/* BLE EM (CONFIG_BL616CL_EM_SIZE) is carved from the top of WRAM, as in
 * the Bouffalo SDK bl616cl_common.ld.in. ram_wifi is the WRAM below EM on
 * the nocache alias, the only view the Wi-Fi hardware uses. .wifibss sits
 * at its top and the heap, on the cacheable alias, runs up to where
 * .wifibss starts, so the split follows the size of .wifibss instead of a
 * fixed WRAM size.
 */

__LD_CONFIG_EM_SEL = CONFIG_BL616CL_EM_SIZE * 1024;

/* OCRAM above 0x20fc0400 (223 KiB) and the WRAM below EM, which follow
 * each other on both RAM aliases.
 */

__bl616cl_ram_size = 224K - 1K + 160K - __LD_CONFIG_EM_SEL;

MEMORY
{
  fw_header   (rx)  : ORIGIN = 0x7ffff000, LENGTH = 4K
  rom_header  (rx)  : ORIGIN = 0x80000000, LENGTH = 6K
  flash       (rx)  : ORIGIN = 0x80001800,
                      LENGTH = __bl616cl_app_size - 4K - 6K
  ram_nocache (!rx) : ORIGIN = 0x20fc0400, LENGTH = __bl616cl_ram_size
  ram         (!rx) : ORIGIN = 0x60fc0400, LENGTH = __bl616cl_ram_size
  ram_wifi    (wxa) : ORIGIN = 0x20ff8000, LENGTH = 160K - __LD_CONFIG_EM_SEL
}

/* Let ld derive program headers from section attributes. Script-generated
 * constants need READONLY because they have no read-only input sections.
 */

SECTIONS
{
  /* Boot header (magic "BFNP", 256 bytes) that boot2 reads, in the 4 KiB
   * before the XIP base. Firmware post-processing fills in its CRCs and
   * the image length.
   */

  .fw_header :
  {
    KEEP(*(.fw_header))
  } > fw_header

  /* Cache maintenance ranges (bl616cl_cache.c, bl616cl_sec_eng.c). The
   * XIP range is the hardware window, not just this image: 64 MiB,
   * BL616CL_FLASH_XIP_END in the LHAL memory map, whatever the flash size
   * of the board. The RAM range ends at the heap limit, set further down.
   */

  __bl616cl_cache_xip_start = ABSOLUTE(ORIGIN(rom_header));
  __bl616cl_cache_xip_end = ABSOLUTE(ORIGIN(rom_header) + 64M);
  __bl616cl_cache_ram_start = ABSOLUTE(ORIGIN(ram));

  __rom_header_start__ = ORIGIN(rom_header);

  .init ORIGIN(rom_header) :
  {
    KEEP(*(.text.entry))
    KEEP(*(SORT_NONE(.init)))
  } > rom_header

  /* Bouffalo multi-bin table: 16-byte entries of an 8-byte name and the
   * start and end offsets in the image file, ended by 0xff. SELF is this
   * image; LP, DWARFCFI, ROMFS, CERTS and AUTOLIST are empty slots.
   * Nothing in this SDK reads the table, and the Bouffalo SDK has moved
   * to 24-byte entries; it is kept as is because the post-processing
   * tools are only available as binaries.
   */

  .multi_bins ORIGIN(rom_header) + 512 (READONLY) :
  {
    __multi_bins__ = ABSOLUTE(.);
    LONG(0x464c4553) LONG(0x00000000)     /* "SELF" */
    LONG(LENGTH(fw_header))
    LONG(__rom_end__ - __rom_header_start__ + LENGTH(fw_header))
    LONG(0x0000504c) LONG(0x00000000)     /* "LP" */
    LONG(0x00000000) LONG(0x00000000)
    LONG(0x52415744) LONG(0x49464346)     /* "DWARFCFI" */
    LONG(0x00000000) LONG(0x00000000)
    LONG(0x464d4f52) LONG(0x00000053)     /* "ROMFS" */
    LONG(0x00000000) LONG(0x00000000)
    LONG(0x54524543) LONG(0x00000053)     /* "CERTS" */
    LONG(0x00000000) LONG(0x00000000)
    LONG(0x4f545541) LONG(0x5453494c)     /* "AUTOLIST" */
    LONG(0x00000000) LONG(0x00000000)
    LONG(0xffffffff) LONG(0xffffffff)
    LONG(0xffffffff) LONG(0xffffffff)
  } > rom_header

  /* RF parameters, 2 KiB: firmware post-processing writes the RF TLVs
   * from the board dts after the "BLRFPARA" magic, and rfparam reads them
   * through _ld_symbol_rftlv_address.
   */

  .rftlv.tool ORIGIN(rom_header) + 1K (READONLY) :
  {
    _ld_symbol_rftlv_address = ABSOLUTE(.);
    LONG(0x46524c42)                      /* "BLRF" */
    LONG(0x41524150)                      /* "PARA" */
    . = ORIGIN(rom_header) + 3K;
  } > rom_header

  /* Version block: "BLFBVERF" and the LHAL bflb_verinf_t, "BLFBVERF" and
   * the .verinfo strings, then the .version.* string pointers of the
   * components (wl80211, macsw, phyrf). Nothing in this SDK reads it.
   */

  .ver ORIGIN(rom_header) + 3K (READONLY) :
  {
    LONG(0x42464c42)                      /* "BLFB" */
    LONG(0x46524556)                      /* "VERF" */
    KEEP(*(.bflb_verinf))
    LONG(0x42464c42)                      /* "BLFB" */
    LONG(0x46524556)                      /* "VERF" */
    KEEP(*(.verinfo))
    . = ALIGN(4);
    _version_info_section_start = ABSOLUTE(.);
    KEEP(*(.version.*))
    _version_info_section_end = ABSOLUTE(.);
  } > rom_header

  .init_code :
  {
    KEEP(*riscv_fpu.S.o(.text))
    KEEP(*bl616cl_start.c.o(.text.__bl616cl_start))
    KEEP(*bl616cl_cpu.c.o(.text.bl616cl_* .rodata.g_bl616cl_pmp_entry))
    KEEP(*bl616cl_memory.c.o(.text.bl616cl_memory_early_init
                             .text.bl616cl_flash_early_init))
    KEEP(*bl616cl_cache.c.o(.text.bl616cl_cache_early_init))
    KEEP(*rv_pmp.c.o(.text.rvpmp_* .rodata.rvpmp_*))
    KEEP(*bl616cl_glb.c.o(.text.GLB_Set_EM_Sel))
  } > rom_header

  __rom_header_used_end__ = ABSOLUTE(.);
  __rom_header_end__ = ORIGIN(rom_header) + LENGTH(rom_header);

  .nocache_data :
  {
    . = ALIGN(4);
    *(.nocache_ram)
    . = ALIGN(4);
  } > ram_nocache AT > flash

  .nocache_noinit (NOLOAD) : AT(ADDR(.nocache_noinit))
  {
    . = ALIGN(4);
    *(.nocache_noinit_ram)
    *(.noncacheable)
    . = ALIGN(4);
  } > ram_nocache

  __ram_nocache_end__ = ABSOLUTE(.);

  .ram_skip_nocache_region (NOLOAD) :
  {
    . += (ABSOLUTE(__ram_nocache_end__) -
          ABSOLUTE(ORIGIN(ram_nocache)));
    . = ALIGN(32);
  } > ram

  .ram_code :
  {
    . = ALIGN(4);
    *(.tcm_code*)
    *(.sclock_rlt_code*)
    . = ALIGN(4);
  } > ram AT > flash

  .ram_rodata :
  {
    . = ALIGN(4);
    *(.tcm_const*)
    *(.sclock_rlt_const*)
    /* Flash command functions use compiler-generated io_mode jump tables
     * before XIP is restored. Keep those tables with the RAM code.
     */

    *bflb_sflash.c.o(.rodata .rodata.* .srodata .srodata.*)

    /* Flash clock calibration switches clocks with XIP disabled. */

    *libbl_std.a:bl616cl_glb.c.o(.rodata .rodata.* .srodata .srodata.*)
    *libbl_std.a:bl616cl_clock.c.o(.rodata .rodata.* .srodata .srodata.*)
    . = ALIGN(4);
  } > ram AT > flash

  .data :
  {
    _sdata = ABSOLUTE(.);
    __global_pointer$ = . + 0x800;
    *(.data .data.*)
    *(.sdata .sdata.*)
    *(.sdata2 .sdata2.*)
    *(.tcm_data*)
    *(.gnu.linkonce.d.*)
    /* zblue device state. Its NuttX port finds devices through tables in
     * code, so the state only has to be initialized like other data.
     */

    *(.z_devstate .z_devstate.*)
    . = ALIGN(4);
    _edata = ABSOLUTE(.);
  } > ram AT > flash

  .noinit (NOLOAD) : AT(ADDR(.noinit))
  {
    *(.noinit .noinit.*)
    /* Preserve the SDK no-init convention for reused objects. */

    *(.noinit_data*)
    . = ALIGN(16);
  } > ram

  /* Wi-Fi shared data: macsw descriptors, wl80211 RX buffer memory and
   * the NuttX IOB pool (CONFIG_IOB_SECTION="SHAREDRAM"), which the MAC
   * transmits from directly. Code puts data here with the macsw
   * __SHAREDRAM/__SHAREDRAMIPC and LHAL ATTR_WIFI_RAM_SECTION attributes.
   * The start is aligned down to the section alignment, so the padding
   * inside and the size do not depend on the address. Startup zeroes it
   * like .bss: its objects have no initializers, and CONFIG_IOB_SECTION
   * must start zeroed.
   */

  .wifibss ((ORIGIN(ram_wifi) + LENGTH(ram_wifi) - SIZEOF(.wifibss)) &
            ~(MAX(ALIGNOF(.wifibss), 16) - 1)) (NOLOAD) :
  {
    _sshram = ABSOLUTE(.);
    *(SHAREDRAMIPC)
    *(SHAREDRAM)
    _eshram = ABSOLUTE(.);
    *(.wifi_ram*)
    . = ALIGN(16);
  } > ram_wifi

  /* The part of ram_wifi taken by .wifibss; the heap gets the rest. */

  __ram_wifi_start = ADDR(.wifibss);
  __ram_wifi_end = ORIGIN(ram_wifi) + LENGTH(ram_wifi);

  .bss (NOLOAD) : AT(ADDR(.bss))
  {
    _sbss = ABSOLUTE(.);
    *(.bss .bss.*)
    *(.sbss .sbss.*)
    *(COMMON)
    . = ALIGN(16);
    _ebss = ABSOLUTE(.);
  } > ram

  .idle_stack (NOLOAD) : AT(ADDR(.idle_stack))
  {
    . = ALIGN(16);
    __StackBase = ABSOLUTE(.);
    . += CONFIG_IDLETHREAD_STACKSIZE;
    __StackTop = ABSOLUTE(.);
  } > ram

  /* The heap runs up to the cacheable alias of __ram_wifi_start. */

  __HeapBase = ALIGN(__StackTop, 16);
  __HeapLimit = __ram_wifi_start - ORIGIN(ram_nocache) + ORIGIN(ram);
  __bl616cl_cache_ram_end = ABSOLUTE(__HeapLimit);

  /* Special RAM sections consume their inputs first. Place the remaining
   * XIP code and constants after their flash load images.  Start the code
   * on a 32 KiB (I-cache size) boundary so that a change in the RAM load
   * images does not move it to other cache sets.
   */

  .text ALIGN(LOADADDR(.data) + SIZEOF(.data), 32K) :
  {
    _stext = ABSOLUTE(.);
    /* Wi-Fi hot paths, listed in bl616cl_wifi_hot.ld */

    __bl616cl_wifi_hot_start = ABSOLUTE(.);
#include "bl616cl_wifi_hot.ld"
    __bl616cl_wifi_hot_end = ABSOLUTE(.);

    *(.text .text.*)
    *(.gnu.linkonce.t.*)
    . = ALIGN(4);
    __bl616cl_text_end = ABSOLUTE(.);
  } > flash

  .rodata :
  {
    *(.rodata .rodata.*)
    *(.srodata .srodata.*)
    *(.gnu.linkonce.r.*)
    /* zblue init entries, which its NuttX port lists in code */

    *(.z_init_*)
    . = ALIGN(4);
    /* NuttX defines _etext as the end of text plus rodata. */

    _etext = ABSOLUTE(.);
  } > flash

  .init_section :
  {
    _sinit = ABSOLUTE(.);
    KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*)))
    KEEP(*(.init_array))
    _einit = ABSOLUTE(.);
  } > flash

  .copy.table (READONLY) :
  {
    __mem_copy_sections = ABSOLUTE(.);
    LONG(ADDR(.nocache_data));
    LONG(ADDR(.nocache_data) + SIZEOF(.nocache_data));
    LONG(LOADADDR(.nocache_data));
    LONG(ADDR(.ram_code));
    LONG(ADDR(.ram_code) + SIZEOF(.ram_code));
    LONG(LOADADDR(.ram_code));
    LONG(ADDR(.ram_rodata));
    LONG(ADDR(.ram_rodata) + SIZEOF(.ram_rodata));
    LONG(LOADADDR(.ram_rodata));
    LONG(ADDR(.data));
    LONG(ADDR(.data) + SIZEOF(.data));
    LONG(LOADADDR(.data));
    LONG(0xffffffff);
    LONG(0xffffffff);
    LONG(0xffffffff);
  } > flash

  .zero.table (READONLY) :
  {
    __mem_setz_sections = ABSOLUTE(.);
    LONG(ADDR(.bss));
    LONG(ADDR(.bss) + SIZEOF(.bss));
    LONG(ADDR(.wifibss));
    LONG(ADDR(.wifibss) + SIZEOF(.wifibss));
    LONG(0xffffffff);
    LONG(0xffffffff);
  } > flash

  /* Keep all flash-backed output sections above this final marker. */

  .image_end (READONLY) :
  {
    . = ALIGN(4);
    __rom_end__ = ABSOLUTE(.);
  } > flash

  /* ld assigns input relocation sections here; the static image must not
   * need any of them at run time (see the ASSERT below).
   */

  .rela.dyn : { *(.rela.*) }

  /* Startup copies and clears complete 32-bit words. */

  ASSERT(((ADDR(.nocache_data) | LOADADDR(.nocache_data) |
           SIZEOF(.nocache_data)) & 3) == 0,
         "BL616CL .nocache_data copy must be word aligned")
  ASSERT(((ADDR(.ram_code) | LOADADDR(.ram_code) |
           SIZEOF(.ram_code)) & 3) == 0,
         "BL616CL .ram_code copy must be word aligned")
  ASSERT(((ADDR(.ram_rodata) | LOADADDR(.ram_rodata) |
           SIZEOF(.ram_rodata)) & 3) == 0,
         "BL616CL .ram_rodata copy must be word aligned")
  ASSERT(((ADDR(.data) | LOADADDR(.data) |
           SIZEOF(.data)) & 3) == 0,
         "BL616CL .data copy must be word aligned")
  ASSERT(((ADDR(.bss) | SIZEOF(.bss)) & 3) == 0,
         "BL616CL .bss clear must be word aligned")
  ASSERT(((ADDR(.wifibss) | SIZEOF(.wifibss)) & 3) == 0,
         "BL616CL .wifibss clear must be word aligned")
  ASSERT(((ADDR(.copy.table) | ADDR(.zero.table)) & 3) == 0,
         "BL616CL startup tables must be word aligned")

  /* Boot image format */

  ASSERT(SIZEOF(.fw_header) == 256,
         "BL616CL firmware header must be 256 bytes")
  ASSERT(SIZEOF(.init) <= 512, "BL616CL reset entry exceeds ROM header")
  ASSERT(ADDR(.rftlv.tool) == ORIGIN(rom_header) + 1K,
         "BL616CL RF TLV offset is invalid")
  ASSERT(ADDR(.ver) == ORIGIN(rom_header) + 3K,
         "BL616CL version offset is invalid")
  ASSERT(__rom_header_used_end__ <= __rom_header_end__,
         "BL616CL pre-cache code exceeds ROM header")

  /* Flash layout */

  ASSERT(__bl616cl_app_size > 4K + 6K,
         "BL616CL application partition is too small")
  ASSERT(LOADADDR(.nocache_data) == ORIGIN(flash),
         "BL616CL RAM load images must follow the ROM header")
  ASSERT(ADDR(.text) == ALIGN(LOADADDR(.data) + SIZEOF(.data), 32K),
         "BL616CL XIP text must follow the RAM load images")
  ASSERT(__rom_end__ <= ORIGIN(flash) + LENGTH(flash),
         "BL616CL flash image overflow")

  /* RAM layout */

  ASSERT(__LD_CONFIG_EM_SEL == 0 || __LD_CONFIG_EM_SEL == 16K ||
         __LD_CONFIG_EM_SEL == 32K, "BL616CL EM size is invalid")
  ASSERT(__ram_nocache_end__ <= ORIGIN(ram_nocache) + LENGTH(ram_nocache),
         "BL616CL nocache RAM overflow")
  ASSERT((__StackTop & 15) == 0, "BL616CL idle stack must be 16-byte aligned")
  ASSERT(__HeapBase < __HeapLimit, "BL616CL cacheable RAM overflow")
  ASSERT(ADDR(.wifibss) >= 0x20ff8000,
         "BL616CL .wifibss must stay in WRAM")
  ASSERT(ADDR(.wifibss) + SIZEOF(.wifibss) <= __ram_wifi_end,
         "BL616CL .wifibss overlaps EM")

  /* Linking */

  ASSERT(SIZEOF(.rela.dyn) == 0, "BL616CL image needs dynamic relocations")

  /DISCARD/ :
  {
    *(.note.GNU-stack)
    *(.riscv.attributes)
  }

  .comment 0 : { *(.comment) }

  /* DWARF 2-5 sections, as in the ld default script */

  .debug_aranges 0 : { *(.debug_aranges) }
  .debug_pubnames 0 : { *(.debug_pubnames) }
  .debug_info 0 : { *(.debug_info .gnu.linkonce.wi.*) }
  .debug_abbrev 0 : { *(.debug_abbrev) }
  .debug_line 0 : { *(.debug_line .debug_line.* .debug_line_end) }
  .debug_frame 0 : { *(.debug_frame) }
  .debug_str 0 : { *(.debug_str) }
  .debug_loc 0 : { *(.debug_loc) }
  .debug_macinfo 0 : { *(.debug_macinfo) }
  .debug_pubtypes 0 : { *(.debug_pubtypes) }
  .debug_ranges 0 : { *(.debug_ranges) }
  .debug_addr 0 : { *(.debug_addr) }
  .debug_line_str 0 : { *(.debug_line_str) }
  .debug_loclists 0 : { *(.debug_loclists) }
  .debug_macro 0 : { *(.debug_macro) }
  .debug_names 0 : { *(.debug_names) }
  .debug_rnglists 0 : { *(.debug_rnglists) }
  .debug_str_offsets 0 : { *(.debug_str_offsets) }
  .debug_sup 0 : { *(.debug_sup) }
}

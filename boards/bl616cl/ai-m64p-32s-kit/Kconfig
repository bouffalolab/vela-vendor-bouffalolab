#

config ARCH_BOARD_AI_M64P_32S_KIT
	def_bool y
	---help---
		Board identity, defined only while this board is selected. Test
		apps that need this board's wiring depend on it.

menuconfig AI_M64P_KIT_UART1
	bool "Ai-M64P-32S-Kit UART1"
	default n
	depends on BL616CL_UART0
	select BL616CL_UART1
	---help---
		Register UART1 as /dev/ttyS1 using the board-owned GPIO14 TX and
		GPIO15 RX test loopback pair. Runtime termios is independently
		controlled by SERIAL_TERMIOS.

menuconfig AI_M64P_KIT_PWM
	bool "Ai-M64P-32S-Kit PWM output"
	default n
	depends on BL616CL_PWM
	---help---
		Register PWM0 as /dev/pwm0 on the selected channels. The channels
		share one frequency. A channel uses a positive output, a negative
		output or both; the negative output is the complement of the
		positive one, also when stopped. Without PWM_MULTICHAN exactly one
		channel must be selected.

		The pin rule depends on the negative pins. While no channel has a
		negative pin, channel n drives positive outputs on GPIOs with
		pin % 4 == n. Once any channel has one, channel n needs
		pin % 8 == 2n for positive and 2n + 1 for negative outputs.

		The selected pins leave the board GPIO test devices and must not be
		used by I2C, SPI or UART1. GPIO28 drives the warm white LED and
		GPIO27 the cold white LED.

if AI_M64P_KIT_PWM

config AI_M64P_KIT_PWM_CH0
	bool "Channel 0"
	default n
	---help---
		Drive PWM0 channel 0. Without negative pins its positive output
		is on a GPIO with pin % 4 == 0; with negative pins the positive
		output needs pin % 8 == 0 and the negative one pin % 8 == 1.

if AI_M64P_KIT_PWM_CH0

config AI_M64P_KIT_PWM_CH0_POS_PIN
	int "Channel 0 positive output GPIO (-1: unused)"
	default 8
	range -1 31

config AI_M64P_KIT_PWM_CH0_NEG_PIN
	int "Channel 0 negative output GPIO (-1: unused)"
	default -1
	range -1 31

endif # AI_M64P_KIT_PWM_CH0

config AI_M64P_KIT_PWM_CH1
	bool "Channel 1"
	default n
	---help---
		Drive PWM0 channel 1. Without negative pins its positive output
		is on a GPIO with pin % 4 == 1; with negative pins the positive
		output needs pin % 8 == 2 and the negative one pin % 8 == 3.

if AI_M64P_KIT_PWM_CH1

config AI_M64P_KIT_PWM_CH1_POS_PIN
	int "Channel 1 positive output GPIO (-1: unused)"
	default 9
	range -1 31

config AI_M64P_KIT_PWM_CH1_NEG_PIN
	int "Channel 1 negative output GPIO (-1: unused)"
	default -1
	range -1 31

endif # AI_M64P_KIT_PWM_CH1

config AI_M64P_KIT_PWM_CH2
	bool "Channel 2"
	default n
	---help---
		Drive PWM0 channel 2. Without negative pins its positive output
		is on a GPIO with pin % 4 == 2; with negative pins the positive
		output needs pin % 8 == 4 and the negative one pin % 8 == 5.

if AI_M64P_KIT_PWM_CH2

config AI_M64P_KIT_PWM_CH2_POS_PIN
	int "Channel 2 positive output GPIO (-1: unused)"
	default 10
	range -1 31

config AI_M64P_KIT_PWM_CH2_NEG_PIN
	int "Channel 2 negative output GPIO (-1: unused)"
	default -1
	range -1 31

endif # AI_M64P_KIT_PWM_CH2

config AI_M64P_KIT_PWM_CH3
	bool "Channel 3"
	default y
	---help---
		Drive PWM0 channel 3. Without negative pins its positive output
		is on a GPIO with pin % 4 == 3; with negative pins the positive
		output needs pin % 8 == 6 and the negative one pin % 8 == 7.

if AI_M64P_KIT_PWM_CH3

config AI_M64P_KIT_PWM_CH3_POS_PIN
	int "Channel 3 positive output GPIO (-1: unused)"
	default 11
	range -1 31

config AI_M64P_KIT_PWM_CH3_NEG_PIN
	int "Channel 3 negative output GPIO (-1: unused)"
	default -1
	range -1 31

endif # AI_M64P_KIT_PWM_CH3

endif # AI_M64P_KIT_PWM

menuconfig AI_M64P_KIT_I2C
	bool "Ai-M64P-32S-Kit I2C buses"
	default n
	select BL616CL_I2C
	---help---
		Register the selected board I2C buses. External 3.3 V targets and
		SCL/SDA pull-ups are required.

if AI_M64P_KIT_I2C

config AI_M64P_KIT_I2C0
	bool "Register I2C0"
	default y
	select BL616CL_I2C0

if AI_M64P_KIT_I2C0

config AI_M64P_KIT_I2C0_SCL_PIN
	int "I2C0 SCL pin"
	range 0 36
	default 4

config AI_M64P_KIT_I2C0_SDA_PIN
	int "I2C0 SDA pin"
	range 0 36
	default 5

endif # AI_M64P_KIT_I2C0

config AI_M64P_KIT_I2C1
	bool "Register I2C1"
	default n
	select BL616CL_I2C1

if AI_M64P_KIT_I2C1

config AI_M64P_KIT_I2C1_SCL_PIN
	int "I2C1 SCL pin"
	range 0 36
	default 12

config AI_M64P_KIT_I2C1_SDA_PIN
	int "I2C1 SDA pin"
	range 0 36
	default 13

endif # AI_M64P_KIT_I2C1
endif # AI_M64P_KIT_I2C

menuconfig AI_M64P_KIT_SPI
	bool "Ai-M64P-32S-Kit SPI buses"
	default n
	select BL616CL_SPI
	---help---
		Register board-selected SPI master buses. SPI0 uses GPIO chip select
		and exposes the OpenVela test device as /dev/spi0.

if AI_M64P_KIT_SPI

config AI_M64P_KIT_SPI0
	bool "Register SPI0"
	default y
	select BL616CL_SPI0
	select SPI_DRIVER
	---help---
		Register SPI0 using the selected BL616CLDK-derived pin mapping.
		This setting owns the selected pins instead of the board GPIO tests.

if AI_M64P_KIT_SPI0

config AI_M64P_KIT_SPI0_CS_PIN
	int "SPI0 GPIO chip-select pin"
	range 0 36
	default 12

config AI_M64P_KIT_SPI0_CLK_PIN
	int "SPI0 clock pin"
	range 0 36
	default 13

config AI_M64P_KIT_SPI0_MISO_PIN
	int "SPI0 MISO pin"
	range 0 36
	default 18

config AI_M64P_KIT_SPI0_MOSI_PIN
	int "SPI0 MOSI pin"
	range 0 36
	default 19

config AI_M64P_KIT_SPI0_CS_ACTIVE_HIGH
	bool "SPI0 chip select is active high"
	default n

config AI_M64P_KIT_SPI0_TARGET_INDEX
	int "SPI0 target 0 SPIDEV_USER index"
	range 0 65535
	default 0

config AI_M64P_KIT_SPI0_TARGET1
	bool "SPI0 target 1"
	default n
	help
	  Enable a second GPIO chip select on SPI0. The target index and GPIO
	  must differ from target 0 and all SPI signal pins.

if AI_M64P_KIT_SPI0_TARGET1

config AI_M64P_KIT_SPI0_TARGET1_CS_PIN
	int "SPI0 target 1 GPIO chip-select pin"
	range 0 36
	default 20

config AI_M64P_KIT_SPI0_TARGET1_CS_ACTIVE_HIGH
	bool "SPI0 target 1 chip select is active high"
	default n

config AI_M64P_KIT_SPI0_TARGET1_INDEX
	int "SPI0 target 1 SPIDEV_USER index"
	range 0 65535
	default 1

endif # AI_M64P_KIT_SPI0_TARGET1

endif # AI_M64P_KIT_SPI0
endif # AI_M64P_KIT_SPI

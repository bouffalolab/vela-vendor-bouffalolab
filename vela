def cmd_build(root: Path, args: Parsed) -> int:
    board = resolve_or_fail(root, args.positionals[0], "build")
    out_dir = build_dir(root, board)
    name = display_name(root, board)

    ensure_fresh_config(root, out_dir, board)
    require_configure(root, out_dir, board, args.options.get("--use-lib", ""))

    jobs = args.options.get("--jobs") or default_jobs()
    status("building", f"{cyan(name, sys.stderr)} ({jobs} jobs)")
    started = time.monotonic()
    if cmake_build(root, out_dir, jobs) != 0:
        fail("build failed", [f"elapsed {dim(f'{time.monotonic() - started:.1f}s')}"], 1)

    artifact = out_dir / "nuttx.bin"
    detail = cyan(name, sys.stderr)
    if artifact.is_file():
        try:
            detail += f" {dim('→', sys.stderr)} {cyan(artifact.relative_to(root).as_posix(), sys.stderr)}"
        except ValueError:
            pass
    done("built", detail, time.monotonic() - started)
    return 0


def cmd_menuconfig(root: Path, args: Parsed) -> int:
    board = resolve_or_fail(root, args.positionals[0], "menuconfig")
    out_dir = build_dir(root, board)
    name = display_name(root, board)

    ensure_fresh_config(root, out_dir, board)
    require_configure(root, out_dir, board, "")

    status("menuconfig", f"{cyan(name, sys.stderr)} (save & exit to continue)")
    before = config_snapshot(out_dir)
    if cmake_menuconfig(root, out_dir) != 0:
        fail("menuconfig failed", [], 1)

    after = config_snapshot(out_dir)
    changed = after is not None and after != before
    if changed and args.options.get("--no-savedefconfig"):
        note("configuration changed; --no-savedefconfig set, defconfig untouched")
    elif changed:
        status("saving", "configuration changed; writing defconfig")
        if cmake_savedefconfig(root, out_dir) != 0:
            fail("savedefconfig failed", [], 1)
        sync_defconfig_copy(out_dir, board)
        try:
            rel = (board / "defconfig").relative_to(root).as_posix()
        except ValueError:
            rel = str(board / "defconfig")
        done("saved", cyan(rel, sys.stderr))
    else:
        note("configuration unchanged")
    return 0


def cmd_savedefconfig(root: Path, args: Parsed) -> int:
    board = resolve_or_fail(root, args.positionals[0], "savedefconfig")
    out_dir = build_dir(root, board)
    name = display_name(root, board)

    ensure_fresh_config(root, out_dir, board)
    require_configure(root, out_dir, board, "")

    status("saving", cyan(name, sys.stderr))
    started = time.monotonic()
    if cmake_savedefconfig(root, out_dir) != 0:
        fail("savedefconfig failed", [], 1)
    sync_defconfig_copy(out_dir, board)
    try:
        rel = (board / "defconfig").relative_to(root).as_posix()
    except ValueError:
        rel = str(board / "defconfig")
    done("saved", cyan(rel, sys.stderr), time.monotonic() - started)
    return 0


def cmd_clean(root: Path, args: Parsed) -> int:
    board = resolve_or_fail(root, args.positionals[0], "clean")
    out_dir = build_dir(root, board)
    try:
        rel = out_dir.relative_to(root).as_posix()
    except ValueError:
        rel = str(out_dir)
    status("cleaning", cyan(rel, sys.stderr))
    if out_dir.exists():
        shutil.rmtree(out_dir)
        done("removed", cyan(rel, sys.stderr))
    else:
        note("nothing to remove")
    return 0


def cmd_clean_all(root: Path) -> int:
    out_root = root / "cmake_out"
    if not out_root.is_dir():
        note(f"nothing to clean: {out_root} does not exist")
        return 0
    removed = [child for child in sorted(out_root.iterdir()) if child.is_dir()]
    if not removed:
        note("nothing to clean under cmake_out")
        return 0
    for child in removed:
        shutil.rmtree(child)
    done("removed", f"{len(removed)} output dir(s)")
    return 0


def cmd_flash(root: Path, args: Parsed) -> int:
    options = args.options
    if options.get("--list"):
        for target in flash_config_candidates(root):
            print(target)
        return 0

    port = options.get("--port")
    addr = options.get("--addr")
    image = options.get("--image")
    config = options.get("--config")

    try:
        baudrate = int(options.get("--baudrate") or 2_000_000)
        if image is not None:
            if port is None:
                fail("'flash' requires --port", ["hint: vela flash --port /dev/ttyUSB2"])
            if addr is None:
                addr = "0x0"
            image_path = Path(image).resolve()
            if not image_path.is_file():
                fail(f"image does not exist: {image_path}", [], 1)
            if image_path.stat().st_size == FLASH_SIZE:
                validate_whole_image(image_path)
            status("flashing", f"{cyan(str(image_path), sys.stderr)} {dim('→', sys.stderr)} "
                              f"{cyan(port, sys.stderr)} @ {baudrate}")
            started = time.monotonic()
            if flash_bin_image(root, image_path, addr, port, baudrate) != 0:
                fail("flash failed", [], 1)
            done("flashed", cyan(port, sys.stderr), time.monotonic() - started)
            return 0

        if config is not None:
            if port is None:
                fail("'flash' requires --port", ["hint: vela flash --port /dev/ttyUSB2"])
            config_path = Path(config).resolve()
            if not config_path.is_file():
                fail(f"flash config does not exist: {config_path}", [], 1)
            status("flashing", f"{cyan(str(config_path), sys.stderr)} {dim('→', sys.stderr)} "
                              f"{cyan(port, sys.stderr)} @ {baudrate}")
            started = time.monotonic()
            if flash_config_image(root, config_path, port, baudrate) != 0:
                fail("flash failed", [], 1)
            done("flashed", cyan(port, sys.stderr), time.monotonic() - started)
            return 0

        if args.positionals:
            board = resolve_or_fail(root, args.positionals[0], "flash")
            name = display_name(root, board)
            ini = build_dir(root, board) / "flash_prog_cfg.ini"
            if not ini.is_file():
                fail(f"no firmware built for {cyan(name, sys.stderr)}",
                     [f"hint: vela build {name}", f"hint: vela flash {name} --port {port or '<tty>'}"], 1)
        else:
            ini = select_flash_config(root)
            name = ini.parent.name

        if port is None:
            fail("'flash' requires --port", ["hint: vela flash --port /dev/ttyUSB2"])
        try:
            ini_rel = ini.relative_to(root).as_posix()
        except ValueError:
            ini_rel = str(ini)
        status("flashing", f"{cyan(name, sys.stderr)} {dim('via', sys.stderr)} "
                          f"{cyan(ini_rel, sys.stderr)} {dim('→', sys.stderr)} "
                          f"{cyan(port, sys.stderr)} @ {baudrate}")
        started = time.monotonic()
        if flash_config_image(root, ini, port, baudrate) != 0:
            fail("flash failed", [], 1)
        done("flashed", cyan(port, sys.stderr), time.monotonic() - started)
        return 0
    except (OSError, RuntimeError, ValueError) as error:
        fail(str(error), [], 1)


def cmd_completion(root: Path, args: Parsed) -> int:
    positionals = args.positionals
    if positionals and positionals[0] == "install":
        shell = positionals[1] if len(positionals) > 1 else detect_shell()
        return install_completion(root, shell)
    shell = positionals[0] if positionals else detect_shell()
    if shell not in ("bash", "zsh", "fish"):
        fail(f"unknown shell '{shell}'",
             ["hint: vela completion [bash|zsh|fish]",
              "hint: vela completion install [bash|zsh|fish]"])
    sys.stdout.write(completion_script(shell, Path(__file__).resolve()))
    return 0


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------


def dispatch(root: Path, args: Parsed) -> int:
    command = args.command
    if command.name == "completion":
        return cmd_completion(root, args)
    if command.name == "flash":
        return cmd_flash(root, args)

    if args.options.get("--list"):
        for name in list_configs(root):
            print(name)
        return 0
    if command.name == "clean" and args.options.get("--all"):
        return cmd_clean_all(root)
    if not args.positionals:
        fail(f"'{command.name}' requires a board target", [f"hint: vela {command.name} --list"])
    return {
        "build": cmd_build,
        "menuconfig": cmd_menuconfig,
        "savedefconfig": cmd_savedefconfig,
        "clean": cmd_clean,
    }[command.name](root, args)


def main(argv: Optional[Sequence[str]] = None) -> int:
    root = find_root(Path(__file__).resolve())
    words = list(sys.argv[1:] if argv is None else argv)

    if not words or words[0] in ("-h", "--help"):
        print_top_help()
        return 0
    if words[0] == "__complete":
        return complete_main(root, words[1:])
    if words[0] == "help":
        if len(words) > 1 and words[1] in COMMANDS:
            print_command_help(COMMANDS[words[1]])
        else:
            print_top_help()
        return 0

    args = parse_args(words)
    return dispatch(root, args)


if __name__ == "__main__":
    raise SystemExit(main())

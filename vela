VERSION = "1.0"
EXTRA_FLAGS = "-Wno-cpp -Wno-deprecated-declarations"
BOARD_ROOT = "vendor/bouffalolab/boards"
FLASH_SIZE = 0x400000
MFG_OFFSET = 0x210000
MFG_SIZE = 0x1F0000
WHOLE_IMAGE_MAGICS = {
    0x000000: bytes.fromhex("42464e50"),
    0x00E000: bytes.fromhex("42465054"),
    0x00F000: bytes.fromhex("42465054"),
    0x010000: bytes.fromhex("42464e50"),
}
TOOLCHAIN_ARCHES = (
    "xtensa",
    "arm",
    "aarch64",
    "riscv",
    "x86_64",
    "tc32",
    "tricore",
)


# ---------------------------------------------------------------------------
# Terminal styling — restrained on purpose: bold labels, magenta identifiers,
# cyan placeholders, dim secondary text, green/red results only. Everything
# degrades to plain text on pipes and terminals that cannot show it.
# ---------------------------------------------------------------------------


def use_color(stream) -> bool:
    if os.environ.get("NO_COLOR") or os.environ.get("TERM") == "dumb":
        return False
    return stream.isatty()


def styled(code: int, text: str, stream=sys.stderr) -> str:
    return f"\033[{code}m{text}\033[0m" if use_color(stream) else text


def bold(text: str, stream=sys.stderr) -> str:
    return styled(1, text, stream)


def dim(text: str, stream=sys.stderr) -> str:
    return styled(2, text, stream)


def magenta(text: str, stream=sys.stderr) -> str:
    return styled(35, text, stream)


def cyan(text: str, stream=sys.stderr) -> str:
    return styled(36, text, stream)


def green(text: str, stream=sys.stderr) -> str:
    return styled(32, text, stream)


def red(text: str, stream=sys.stderr) -> str:
    return styled(31, text, stream)


def status(verb: str, detail: str = "") -> None:
    """Print a progress line (stderr): 'configuring   <detail>'."""
    suffix = f" {detail}" if detail else ""
    print(f"{dim(verb.ljust(12), sys.stderr)}{suffix}", file=sys.stderr)


def done(verb: str, detail: str, seconds: Optional[float] = None) -> None:
    """Print a result line (stderr): '✓ built <detail> [38.2s]'."""
    elapsed = f" {dim(f'[{seconds:.1f}s]', sys.stderr)}" if seconds is not None else ""
    print(f"{green('✓', sys.stderr)} {verb:<11}{detail}{elapsed}", file=sys.stderr)


def fail(message: str, hints: Sequence[str] = (), code: int = 2) -> NoReturn:
    """Print an error line (stderr) plus indented hints, then exit."""
    print(f"{red('✗', sys.stderr)} {message}", file=sys.stderr)
    for hint in hints:
        print(f"  {hint}", file=sys.stderr)
    raise SystemExit(code)


def note(message: str) -> None:
    print(f"  {dim(message, sys.stderr)}", file=sys.stderr)



def serial_ports() -> list:
    ports = []
    for pattern in ("ttyUSB*", "ttyACM*"):
        ports.extend(str(path) for path in Path("/dev").glob(pattern))
    return sorted(ports)


def complete_candidates(root: Path, words: Sequence[str]) -> list:
    """Completion candidates for the words typed so far (last word is partial)."""
    command_names = list(COMMANDS)
    if not words:
        return [*command_names, "help", "--help", "-h"]

    first = words[0]
    if first == "help":
        return command_names
    if first not in COMMANDS:
        return [*command_names, "help", "--help", "-h"] if len(words) == 1 else []
    if len(words) == 1:
        return ["--help", "-h"]

    prev = words[-2]
    if prev == "--addr":
        return ["0x0"]
    if prev == "--config":
        return sorted(str(p) for p in root.glob("cmake_out/*/flash_prog_cfg.ini"))
    if prev in ("-j", "--jobs"):
        return [default_jobs()]
    if prev == "--port":
        return serial_ports()
    if prev in ("--baudrate", "--use-lib", "--image"):
        return []
    if first == "completion":
        return ["bash", "zsh", "fish", "install"]

    opts = flag_names(COMMANDS[first])
    if words[-1].startswith("-") or len(words) >= 3:
        return opts
    if first == "flash":
        return sorted({*flash_config_candidates(root), *list_configs(root)}, key=str) + opts
    return [*list_configs(root), *opts]


def complete_main(root: Path, words: Sequence[str]) -> int:
    """Internal: print completion candidates, one per line."""
    candidates = complete_candidates(root, words)
    prefix = words[-1] if words else ""
    for candidate in candidates:
        if candidate.startswith(prefix):
            print(candidate)
    return 0


def completion_script(shell: str, script: Path) -> str:
    """Completion shim for one shell. The shim re-runs `vela __complete`, so
    candidates (including newly added boards) are always generated live."""
    quoted = str(script)
    if shell == "zsh":
        return f"""#compdef vela
# zsh completion for vela — installed by `vela completion install`
_vela() {{
    local -a candidates
    candidates=( "${{(@f)$( {quoted} __complete "${{(@)words[2,-1]}}" 2>/dev/null )}}" )
    _describe -t vela 'vela' candidates
}}
compdef _vela vela
"""
    if shell == "bash":
        return f"""# bash completion for vela — installed by `vela completion install`
_vela_complete() {{
    local IFS=$'\\n'
    COMPREPLY=( $( {quoted} __complete "${{COMP_WORDS[@]:1}}" 2>/dev/null ) )
}}
complete -F _vela_complete vela
"""
    return f"""# fish completion for vela — installed by `vela completion install`
complete -c vela -f -a '( {quoted} __complete (commandline -opc) 2>/dev/null )'
"""


def detect_shell() -> str:
    return Path(os.environ.get("SHELL", "zsh")).name


def install_completion(root: Path, shell: str) -> int:
    """Install the completion shim into a directory the shell already scans.

    Prefers zero-injection targets: oh-my-zsh's fpath directory for zsh,
    bash-completion's user directory for bash, fish's completion directory.
    Falls back to print-mode instructions when none applies.
    """
    script = Path(__file__).resolve()
    if shell == "zsh":
        omz = Path(os.environ.get("ZSH") or Path.home() / ".oh-my-zsh")
        target = None
        if omz.is_dir():
            custom = Path(os.environ.get("ZSH_CUSTOM") or omz / "custom")
            target = custom / "completions"
            target.mkdir(parents=True, exist_ok=True)
        else:
            # Plain zsh: probe $fpath for an existing, writable directory.
            try:
                probe = subprocess.run(
                    ["zsh", "-ic", "print -l $fpath"],
                    capture_output=True, text=True, timeout=10,
                )
                fpath = probe.stdout.split() if probe.returncode == 0 else []
            except (OSError, subprocess.SubprocessError):
                fpath = []
            for candidate in map(Path, fpath):
                if candidate.is_dir() and os.access(candidate, os.W_OK):
                    target = candidate
                    break
        if target is None:
            fail(
                "no writable completion directory found for zsh",
                ["hint: vela completion zsh    # print the script and install manually"],
            )
        (target / "_vela").write_text(completion_script("zsh", script))
        done("installed", cyan(str(target / "_vela")))
        note("run once to refresh zsh's completion cache: rm -f ~/.zcompdump* && exec zsh")
        return 0

    if shell == "bash":
        user_dir = Path.home() / ".local" / "share" / "bash-completion" / "completions"
        has_bash_completion = (
            Path("/usr/share/bash-completion/bash_completion").is_file()
            or Path("/etc/bash_completion").exists()
        )
        if not (has_bash_completion or user_dir.is_dir()):
            fail(
                "bash-completion is not installed",
                ["hint: install the bash-completion package, or use:",
                 "hint: vela completion bash > ~/.bash_completion.d/vela  # then source it"],
            )
        user_dir.mkdir(parents=True, exist_ok=True)
        (user_dir / "vela").write_text(completion_script("bash", script))
        done("installed", cyan(str(user_dir / "vela")))
        note("effective in new shells (bash-completion lazy-loads it on first TAB)")
        return 0

    if shell == "fish":
        target = Path.home() / ".config" / "fish" / "completions"
        target.mkdir(parents=True, exist_ok=True)
        (target / "vela.fish").write_text(completion_script("fish", script))
        done("installed", cyan(str(target / "vela.fish")))
        note("fish picks it up automatically in new shells")
        return 0

    fail(f"unknown shell '{shell}'", ["hint: vela completion install [bash|zsh|fish]"])



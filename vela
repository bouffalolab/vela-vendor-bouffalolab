def colorize_usage(usage: str, stream) -> str:
    """Cyan the placeholder tokens (<board>, [flags], ...) in a usage line."""
    return re.sub(r"(<[^>]+>|\[[^\]]+\])", lambda m: cyan(m.group(1), stream), usage)


def print_top_help() -> None:
    stream = sys.stdout
    name_width = max(len(c.name) for c in COMMANDS.values())
    example_width = max(len(c.example) for c in COMMANDS.values())

    print(f"{bold('vela', stream)} — BL Vela SDK build & flash tool. {dim(f'({VERSION})', stream)}")
    print()
    print(f"{bold('Usage:', stream)} vela <command> {cyan('[<board>]', stream)} {cyan('[...flags]', stream)}")
    print()
    print(bold("Commands:", stream))
    for command in COMMANDS.values():
        print(
            f"  {magenta(command.name.ljust(name_width), stream)}  "
            f"{dim(command.example.ljust(example_width), stream)}  {command.desc}"
        )
    print()
    print(f"  {bold('<command> --help', stream)}    Print help for a command.")


def print_command_help(command: Command) -> None:
    stream = sys.stdout
    print(command.detail)
    print()
    usage = f"vela {command.name} " + (
        "[<board>] [flags]" if command.args_help else "[zsh|bash|fish|install]"
    )
    print(f"{bold('Usage:', stream)} {colorize_usage(usage, stream)}")
    if command.args_help:
        print()
        print(bold("Arguments:", stream))
        print(f"  {cyan('<board>', stream)}    {command.args_help}")
    print()
    print(bold("Flags:", stream))
    rows = []
    for flag in command.flags:
        if flag.short:
            flag_part = f"  {flag.short}, {flag.long}"
        else:
            flag_part = f"      {flag.long}"
        if flag.takes_value:
            flag_part += f" <{flag.value_name}>"
        help_text = flag.help
        if flag.default is not None:
            help_text += f" {dim(f'(default: {flag.default})', stream)}"
        rows.append((flag_part, help_text))
    rows.append(("  -h, --help", "Print this help"))
    width = max(len(part) for part, _ in rows)
    for part, help_text in rows:
        print(f"{colorize_usage(part.ljust(width), stream)}    {help_text}")


# ---------------------------------------------------------------------------
# Argument parsing (hand-rolled so errors match the help's style)
# ---------------------------------------------------------------------------


@dataclass
class Parsed:
    command: Command
    options: dict  # long name -> True (store-true) or str (value)
    positionals: list


def parse_args(words: Sequence[str]) -> Parsed:
    name = words[0]
    command = COMMANDS.get(name)
    if command is None:
        close = difflib.get_close_matches(name, COMMANDS, n=1, cutoff=0.5)
        hints = []
        if close:
            hints.append(f"did you mean {cyan(close[0], sys.stderr)}?")
        hints.append(f"hint: vela --help")
        fail(f"unknown command {cyan(name, sys.stderr)}", hints)

    by_name = {}
    for flag in command.flags:
        by_name[flag.long] = flag
        if flag.short:
            by_name[flag.short] = flag

    options: dict = {}
    positionals: list = []
    tokens = list(words[1:])
    index = 0
    while index < len(tokens):
        token = tokens[index]
        index += 1

        if token in ("-h", "--help"):
            print_command_help(command)
            raise SystemExit(0)

        if token.startswith("--"):
            flag_name, eq, value = token.partition("=")
            flag = by_name.get(flag_name)
            if flag is None:
                close = difflib.get_close_matches(flag_name, list(by_name), n=1, cutoff=0.6)
                hints = []
                if close:
                    hints.append(f"did you mean {cyan(close[0], sys.stderr)}?")
                hints.append(f"hint: vela {command.name} --help")
                fail(f"unknown flag '{flag_name}' for '{command.name}'", hints)
            if not flag.takes_value:
                if eq:
                    fail(f"flag '{flag_name}' takes no value",
                         [f"hint: vela {command.name} --help"])
                options[flag.long] = True
                continue
            if not eq:
                if index >= len(tokens):
                    fail(f"flag '{flag_name}' expects a value",
                         [f"hint: vela {command.name} --help"])
                value = tokens[index]
                index += 1
            options[flag.long] = value
            continue

        if token.startswith("-") and len(token) > 1:
            short = token[:2]
            flag = by_name.get(short)
            if flag is None:
                close = difflib.get_close_matches(short, list(by_name), n=1, cutoff=0.6)
                hints = []
                if close:
                    hints.append(f"did you mean {cyan(close[0], sys.stderr)}?")
                hints.append(f"hint: vela {command.name} --help")
                fail(f"unknown flag '{token}' for '{command.name}'", hints)
            value = token[2:]
            if not flag.takes_value:
                options[flag.long] = True
                continue
            if not value:
                if index >= len(tokens):
                    fail(f"flag '{short}' expects a value",
                         [f"hint: vela {command.name} --help"])
                value = tokens[index]
                index += 1
            options[flag.long] = value
            continue

        positionals.append(token)

    return Parsed(command=command, options=options, positionals=positionals)


